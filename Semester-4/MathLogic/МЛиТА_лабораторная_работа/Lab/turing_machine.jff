<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--Created with JFLAP 7.1.-->
<structure>
	<type>turing</type>
	<automaton>
		<!-- ============================================================
		     МЛиТА. Лабораторная работа. Вариант 6 (Тоцкий В.С.)
		     f(x,y,z,t) = yzt + xyt + xyz   (mod 2)
		     Вход на ленте: xyzt (4 двоичных символа).
		     Выход на ленте: 0 или 1 (один символ, в позиции
		     первоначального x; все остальные символы стёрты).
		     ============================================================ -->

		<!-- Старт. Голова на x. -->
		<state id="0" name="q0">
			<x>60</x><y>320</y>
			<initial/>
		</state>

		<!-- После чтения x: q_x∈{0,1} -->
		<state id="1" name="qx0"><x>200</x><y>180</y></state>
		<state id="2" name="qx1"><x>200</x><y>460</y></state>

		<!-- После чтения xy: q_xy -->
		<state id="3" name="qxy00"><x>340</x><y>80</y></state>
		<state id="4" name="qxy01"><x>340</x><y>240</y></state>
		<state id="5" name="qxy10"><x>340</x><y>400</y></state>
		<state id="6" name="qxy11"><x>340</x><y>560</y></state>

		<!-- После чтения xyz: q_xyz (8 состояний) -->
		<state id="7"  name="qxyz000"><x>500</x><y>30</y></state>
		<state id="8"  name="qxyz001"><x>500</x><y>110</y></state>
		<state id="9"  name="qxyz010"><x>500</x><y>200</y></state>
		<state id="10" name="qxyz011"><x>500</x><y>280</y></state>
		<state id="11" name="qxyz100"><x>500</x><y>370</y></state>
		<state id="12" name="qxyz101"><x>500</x><y>450</y></state>
		<state id="13" name="qxyz110"><x>500</x><y>540</y></state>
		<state id="14" name="qxyz111"><x>500</x><y>620</y></state>

		<!-- Стирающие проходы. Несут уже вычисленный результат. -->
		<state id="15" name="erase0"><x>700</x><y>240</y></state>
		<state id="16" name="erase1"><x>700</x><y>400</y></state>

		<!-- Финальное состояние -->
		<state id="17" name="qF"><x>880</x><y>320</y><final/></state>

		<!-- ====================== Переходы ====================== -->

		<!-- q0: читаем x, движемся вправо к y -->
		<transition><from>0</from><to>1</to><read>0</read><write>0</write><move>R</move></transition>
		<transition><from>0</from><to>2</to><read>1</read><write>1</write><move>R</move></transition>

		<!-- qx0/qx1: читаем y, движемся вправо к z -->
		<transition><from>1</from><to>3</to><read>0</read><write>0</write><move>R</move></transition>
		<transition><from>1</from><to>4</to><read>1</read><write>1</write><move>R</move></transition>
		<transition><from>2</from><to>5</to><read>0</read><write>0</write><move>R</move></transition>
		<transition><from>2</from><to>6</to><read>1</read><write>1</write><move>R</move></transition>

		<!-- qxy: читаем z, движемся вправо к t -->
		<transition><from>3</from><to>7</to><read>0</read><write>0</write><move>R</move></transition>
		<transition><from>3</from><to>8</to><read>1</read><write>1</write><move>R</move></transition>
		<transition><from>4</from><to>9</to><read>0</read><write>0</write><move>R</move></transition>
		<transition><from>4</from><to>10</to><read>1</read><write>1</write><move>R</move></transition>
		<transition><from>5</from><to>11</to><read>0</read><write>0</write><move>R</move></transition>
		<transition><from>5</from><to>12</to><read>1</read><write>1</write><move>R</move></transition>
		<transition><from>6</from><to>13</to><read>0</read><write>0</write><move>R</move></transition>
		<transition><from>6</from><to>14</to><read>1</read><write>1</write><move>R</move></transition>

		<!-- qxyz: читаем t, вычисляем f, стираем t, идём влево.
		     f = yzt + xyt + xyz (по таблице истинности):
		       0000→0  0100→0  1000→0  1100→0
		       0001→0  0101→0  1001→0  1101→1
		       0010→0  0110→0  1010→0  1110→1
		       0011→0  0111→1  1011→0  1111→1
		-->
		<!-- xyz=000: f(0,0,0,0)=0; f(0,0,0,1)=0  → erase0 -->
		<transition><from>7</from><to>15</to><read>0</read><write/><move>L</move></transition>
		<transition><from>7</from><to>15</to><read>1</read><write/><move>L</move></transition>

		<!-- xyz=001: f(0,0,1,0)=0; f(0,0,1,1)=0  → erase0 -->
		<transition><from>8</from><to>15</to><read>0</read><write/><move>L</move></transition>
		<transition><from>8</from><to>15</to><read>1</read><write/><move>L</move></transition>

		<!-- xyz=010: f(0,1,0,0)=0; f(0,1,0,1)=0  → erase0 -->
		<transition><from>9</from><to>15</to><read>0</read><write/><move>L</move></transition>
		<transition><from>9</from><to>15</to><read>1</read><write/><move>L</move></transition>

		<!-- xyz=011: f(0,1,1,0)=0; f(0,1,1,1)=1 -->
		<transition><from>10</from><to>15</to><read>0</read><write/><move>L</move></transition>
		<transition><from>10</from><to>16</to><read>1</read><write/><move>L</move></transition>

		<!-- xyz=100: f(1,0,0,0)=0; f(1,0,0,1)=0  → erase0 -->
		<transition><from>11</from><to>15</to><read>0</read><write/><move>L</move></transition>
		<transition><from>11</from><to>15</to><read>1</read><write/><move>L</move></transition>

		<!-- xyz=101: f(1,0,1,0)=0; f(1,0,1,1)=0  → erase0 -->
		<transition><from>12</from><to>15</to><read>0</read><write/><move>L</move></transition>
		<transition><from>12</from><to>15</to><read>1</read><write/><move>L</move></transition>

		<!-- xyz=110: f(1,1,0,0)=0; f(1,1,0,1)=1 -->
		<transition><from>13</from><to>15</to><read>0</read><write/><move>L</move></transition>
		<transition><from>13</from><to>16</to><read>1</read><write/><move>L</move></transition>

		<!-- xyz=111: f(1,1,1,0)=1; f(1,1,1,1)=1  → erase1 -->
		<transition><from>14</from><to>16</to><read>0</read><write/><move>L</move></transition>
		<transition><from>14</from><to>16</to><read>1</read><write/><move>L</move></transition>

		<!-- erase0: стереть z, y, x; затем на левом blank записать 0 -->
		<transition><from>15</from><to>15</to><read>0</read><write/><move>L</move></transition>
		<transition><from>15</from><to>15</to><read>1</read><write/><move>L</move></transition>
		<transition><from>15</from><to>17</to><read/><write>0</write><move>S</move></transition>

		<!-- erase1: стереть z, y, x; затем на левом blank записать 1 -->
		<transition><from>16</from><to>16</to><read>0</read><write/><move>L</move></transition>
		<transition><from>16</from><to>16</to><read>1</read><write/><move>L</move></transition>
		<transition><from>16</from><to>17</to><read/><write>1</write><move>S</move></transition>
	</automaton>
</structure>
